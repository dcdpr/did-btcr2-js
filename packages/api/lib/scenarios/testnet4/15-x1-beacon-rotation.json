{
  "id": "15-x1-beacon-rotation",
  "description": "x1 DID; update 1 replaces the endpoint of the #initialP2PKH singleton beacon with a new address (beacon rotation); update 2 is anchored at the rotated beacon.",
  "network": "testnet4",
  "idType": "EXTERNAL",
  "keys": {
    "source": "fixed",
    "secretHex": "b18ca111c6fa7f97372a0d2df93cf082d2a1b4de35207c84f67e0ccb6d93184c"
  },
  "extraKeys": {
    "rotated": {
      "source": "fixed",
      "secretHex": "1ce4d9a3eccf6563c604c4731106266ddfb3470d7f016e39b5c1b2585aa3f5ff"
    }
  },
  "updates": [
    {
      "patches": [
        {
          "op": "replace",
          "path": "/service/0/serviceEndpoint",
          "value": "bitcoin:$address(rotated,p2pkh)"
        }
      ],
      "verificationMethodId": "#initialKey",
      "beaconId": "#initialP2WPKH",
      "delivery": "sidecar"
    },
    {
      "patches": [
        {
          "op": "add",
          "path": "/service/3",
          "value": {
            "id": "#didcomm",
            "type": "DIDCommMessaging",
            "serviceEndpoint": "http://example.com/didcomm"
          }
        }
      ],
      "verificationMethodId": "#initialKey",
      "beaconId": "#initialP2PKH",
      "delivery": "sidecar"
    }
  ],
  "beacons": [
    {
      "kind": "P2PKH",
      "id": "#initialP2PKH"
    },
    {
      "kind": "P2WPKH",
      "id": "#initialP2WPKH"
    },
    {
      "kind": "P2TR",
      "id": "#initialP2TR"
    }
  ]
}
