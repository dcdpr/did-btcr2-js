{
  "id": "26-k1-signal-below-current-height",
  "description": "k1 DID; update 1 adds the beacon #lateBeacon and is anchored in round 2. Update 2 is anchored at #lateBeacon in round 1, one block before update 1. The signal is below current_block_height, so a resolver ignores it. The sub-vector asks for version 3 and expects NOT_FOUND.",
  "network": "mutinynet",
  "idType": "KEY",
  "keys": {
    "source": "fixed",
    "secretHex": "e29f25141c2c1362d422f8aee425f22975a5fc31c65c85f931ef696d2064fb95"
  },
  "extraKeys": {
    "lateBeacon": {
      "source": "fixed",
      "secretHex": "5e16b7a85a7b258e60cb67f37c8b71b1f289310a5d553966cc8feef4db72c4c1"
    }
  },
  "updates": [
    {
      "patches": [
        {
          "op": "add",
          "path": "/service/3",
          "value": {
            "id": "#lateBeacon",
            "type": "SingletonBeacon",
            "serviceEndpoint": "bitcoin:$address(lateBeacon,p2wpkh)"
          }
        }
      ],
      "verificationMethodId": "#initialKey",
      "beaconId": "#initialP2WPKH",
      "delivery": "sidecar",
      "round": 2
    },
    {
      "patches": [
        {
          "op": "add",
          "path": "/service/4",
          "value": {
            "id": "#dwn",
            "type": "DecentralizedWebNode",
            "serviceEndpoint": "http://example.com/dwn"
          }
        }
      ],
      "verificationMethodId": "#initialKey",
      "beaconId": "#lateBeacon",
      "delivery": "sidecar",
      "round": 1,
      "belowCurrentHeight": true
    }
  ],
  "resolves": [
    {
      "id": "01",
      "options": {
        "versionId": "3"
      },
      "expect": {
        "error": "NOT_FOUND"
      }
    }
  ],
  "beacons": [
    {
      "kind": "P2PKH",
      "id": "#initialP2PKH"
    },
    {
      "kind": "P2WPKH",
      "id": "#initialP2WPKH"
    },
    {
      "kind": "P2TR",
      "id": "#initialP2TR"
    }
  ]
}
