          "value": "$did#key-1"
        }
      ],
      "verificationMethodId": "#initialKey",
      "beaconId": "#initialP2WPKH",
      "delivery": "sidecar"
    },
    {
      "patches": [
        {
          "op": "add",
          "path": "/service/3",
          "value": {
            "id": "#didcomm",
            "type": "DIDCommMessaging",
            "serviceEndpoint": "http://example.com/didcomm"
          }
        }
      ],
      "verificationMethodId": "#key-1",
      "beaconId": "#initialP2WPKH",
      "delivery": "sidecar"
    }
  ],
  "beacons": [
    {
      "kind": "P2PKH",
      "id": "#initialP2PKH"
    },
    {
      "kind": "P2WPKH",
      "id": "#initialP2WPKH"
    },
    {
      "kind": "P2TR",
