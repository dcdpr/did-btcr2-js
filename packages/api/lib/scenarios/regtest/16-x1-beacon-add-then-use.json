{
  "id": "16-x1-beacon-add-then-use",
  "description": "x1 DID; update 1 adds a fourth singleton beacon #newBeacon; update 2 is anchored at #newBeacon, so the resolver needs a second discovery round.",
  "network": "regtest",
  "idType": "EXTERNAL",
  "keys": {
    "source": "fixed",
    "secretHex": "ae0ac45abb908b1309b732199e9296851ac296e85036164fb6c28509faa0ef5b"
  },
  "extraKeys": {
    "newBeacon": {
      "source": "fixed",
      "secretHex": "53edc3eec3693921bae01fcc4d3fb370886025afa5eaf7bcc326f22884d34fb3"
    }
  },
  "updates": [
    {
      "patches": [
        {
          "op": "add",
          "path": "/service/3",
          "value": {
            "id": "#newBeacon",
            "type": "SingletonBeacon",
            "serviceEndpoint": "bitcoin:$address(newBeacon,p2wpkh)"
          }
        }
      ],
      "verificationMethodId": "#initialKey",
      "beaconId": "#initialP2WPKH",
      "delivery": "sidecar"
    },
    {
      "patches": [
        {
          "op": "add",
          "path": "/service/4",
          "value": {
            "id": "#dwn",
            "type": "DecentralizedWebNode",
            "serviceEndpoint": "http://example.com/dwn"
          }
        }
      ],
      "verificationMethodId": "#initialKey",
      "beaconId": "#newBeacon",
      "delivery": "sidecar"
    }
  ],
  "beacons": [
    {
      "kind": "P2PKH",
      "id": "#initialP2PKH"
    },
    {
      "kind": "P2WPKH",
      "id": "#initialP2WPKH"
    },
    {
      "kind": "P2TR",
      "id": "#initialP2TR"
    }
  ]
}
