{
  "id": "15-x1-beacon-rotation",
  "description": "x1 DID; update 1 replaces the endpoint of the #initialP2PKH singleton beacon with a new address (beacon rotation); update 2 is anchored at the rotated beacon.",
  "network": "signet",
  "idType": "EXTERNAL",
  "keys": {
    "source": "fixed",
    "secretHex": "311980c526f3f2e71ff030bab6c99d347a7788cbe76ea5a37e4bc2a716f43dd7"
  },
  "extraKeys": {
    "rotated": {
      "source": "fixed",
      "secretHex": "74232c12dec1a4b8bb247cce23130ff7d07c6c062bcf2191727928342d885fd1"
    }
  },
  "updates": [
    {
      "patches": [
        {
          "op": "replace",
          "path": "/service/0/serviceEndpoint",
          "value": "bitcoin:$address(rotated,p2pkh)"
        }
      ],
      "verificationMethodId": "#initialKey",
      "beaconId": "#initialP2WPKH",
      "delivery": "sidecar"
    },
    {
      "patches": [
        {
          "op": "add",
          "path": "/service/3",
          "value": {
            "id": "#didcomm",
            "type": "DIDCommMessaging",
            "serviceEndpoint": "http://example.com/didcomm"
          }
        }
      ],
      "verificationMethodId": "#initialKey",
      "beaconId": "#initialP2PKH",
      "delivery": "sidecar"
    }
  ],
  "beacons": [
    {
      "kind": "P2PKH",
      "id": "#initialP2PKH"
    },
    {
      "kind": "P2WPKH",
      "id": "#initialP2WPKH"
    },
    {
      "kind": "P2TR",
      "id": "#initialP2TR"
    }
  ]
}
