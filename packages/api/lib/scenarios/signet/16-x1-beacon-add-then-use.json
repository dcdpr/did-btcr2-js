{
  "id": "16-x1-beacon-add-then-use",
  "description": "x1 DID; update 1 adds a fourth singleton beacon #newBeacon; update 2 is anchored at #newBeacon, so the resolver needs a second discovery round.",
  "network": "signet",
  "idType": "EXTERNAL",
  "keys": {
    "source": "fixed",
    "secretHex": "a504705c793d188a97da328e0b93e13ede6372dedc33b1338a6c394839c76095"
  },
  "extraKeys": {
    "newBeacon": {
      "source": "fixed",
      "secretHex": "ca64142c604a5c177de2ce926638a1cd4655761094e6a146517e700891578344"
    }
  },
  "updates": [
    {
      "patches": [
        {
          "op": "add",
          "path": "/service/3",
          "value": {
            "id": "#newBeacon",
            "type": "SingletonBeacon",
            "serviceEndpoint": "bitcoin:$address(newBeacon,p2wpkh)"
          }
        }
      ],
      "verificationMethodId": "#initialKey",
      "beaconId": "#initialP2WPKH",
      "delivery": "sidecar"
    },
    {
      "patches": [
        {
          "op": "add",
          "path": "/service/4",
          "value": {
            "id": "#dwn",
            "type": "DecentralizedWebNode",
            "serviceEndpoint": "http://example.com/dwn"
          }
        }
      ],
      "verificationMethodId": "#initialKey",
      "beaconId": "#newBeacon",
      "delivery": "sidecar"
    }
  ],
  "beacons": [
    {
      "kind": "P2PKH",
      "id": "#initialP2PKH"
    },
    {
      "kind": "P2WPKH",
      "id": "#initialP2WPKH"
    },
    {
      "kind": "P2TR",
      "id": "#initialP2TR"
    }
  ]
}
